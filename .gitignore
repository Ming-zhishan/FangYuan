# Repository safety: never track live services, secrets, generated caches or local data.
/runtime/
/archive/
/operations/legacy-tools/
/operations/migration/*private*
/research/media-catalog/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.log
*.tmp
*.pid
*.lock
*.zip
*.7z
*.rar
*.pt
*.onnx
*.safetensors
*.gguf
*.ggml
*.wav
*.mp3
*.flac
*.mp4
*.mkv
*.gif
*.png
