*.jpeg
*.webp
.env
.env.*
!.env.example
**/private/
**/secrets/
**/token*
**/credentials*
**/node_modules/
**/__pycache__/
**/.venv/
**/.git/

# Machine-only physical paths; required on TJ, never published.
/config/project-paths.local.json

/services/

/operations/migration/*.jsonl

/operations/migration/physical-copy-journal.jsonl

/operations/migration/


# Generated Aurabot snapshots; the canonical sibling source is tracked.
**/.aurabot-cache/
# Local-only path override and developer editor files
/config/project-paths.local.json
.vscode/
.idea/
.DS_Store
