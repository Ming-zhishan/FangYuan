# Portable example. Set FY_PROJECT_ROOT to your own project directory.
# No real credentials in this file. The entry script computes all paths from its location.
FY_PROJECT_ROOT=<absolute project root>
FY_SOURCE_ROOT=<project root>/src
FY_QQ_RUNTIME=<project root>/runtime/qq-stack
FY_DSH_RUNTIME=<project root>/runtime/dsh-live
FY_MEDIA_ROOT=<project root>/research/media-catalog
# Preserve active DSH_HOME and AURABOT_* from the running environment.
